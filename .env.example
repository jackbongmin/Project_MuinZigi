# 사용법: 이 파일을 복사해 .env를 만들고 빈 값을 채움 (이 파일은 지우거나 이름을 바꾸지 않음)
#   PowerShell: Copy-Item .env.example .env
# 이 파일에는 비밀이 아닌 개발용 기본값만 둠. 키·비밀번호는 .env에만 적음

# Jev (TypeSafe 콘솔에서 발급한 키)
JEV_API_KEY=

# PostgreSQL (infra/docker-compose.yml과 Spring이 같이 씀)
# DB_HOST, DB_PORT는 적지 않으면 localhost, 5433을 씀 (PC에 설치된 PostgreSQL이 5432를 쓰기 때문)
# 바꿀 때만 주석을 풀고 값을 적음. 빈 값(DB_PORT=)으로 두면 Spring이 빈 문자열을 그대로 써서 접속 주소가 깨짐
# DB_HOST=localhost
# DB_PORT=5433
DB_NAME=mujinjigi
DB_USERNAME=mujinjigi
DB_PASSWORD=

# JWT (3단계에서 사용)
JWT_SECRET=
